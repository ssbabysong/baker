        "name": "乡村欧包",
        "yield": "1 个 · 约 800g",
        "notes": "面团状态比时间更重要：一次发酵到体积约 1.5 倍、表面有气泡就可以了。",
        "ingredients": [
          {
            "name": "高筋面粉",
            "amount": 400,
            "unit": "g"
          },
          {
            "name": "全麦粉",
            "amount": 100,
            "unit": "g"
          },
          {
            "name": "水",
            "amount": 360,
            "unit": "g",
            "note": "约 30°C"
          },
          {
            "name": "盐",
            "amount": 10,
            "unit": "g"
          },
          {
            "name": "即发干酵母",
            "amount": 3,
            "unit": "g"
          }
        ],
        "steps": [
          {
            "text": "面粉和水混合成团，静置水解",
            "minutes": 30,
            "kind": "rest"
          },
          {
            "text": "加入盐和酵母，揉到面团光滑",
            "minutes": 10,
            "kind": "knead"
          },
          {
            "text": "一次发酵，期间每 30 分钟折叠一次",
            "minutes": 120,
            "kind": "ferment"
          },
          {
            "text": "预整形后松弛",
            "minutes": 20,
            "kind": "rest"
          },
          {
            "text": "整形放入发酵篮，二次发酵",
            "minutes": 60,
            "kind": "ferment"
          },
          {
            "text": "烤箱连铸铁锅预热到 250°C",
            "minutes": 45,
            "kind": "bake"
          },
          {
            "text": "割包入锅，盖盖烤",
            "minutes": 20,
            "kind": "bake"
          },
          {
            "text": "开盖降到 230°C 继续烤至深棕色",
            "minutes": 20,
            "kind": "bake"
          },
          {
            "text": "出炉放凉再切",
            "minutes": 60,
            "kind": "rest"
          }
        ]
      },
      "en": {
        "name": "Country Loaf",
        "yield": "1 loaf · about 800g",
        "notes": "Watch the dough, not the clock: bulk is done at about 1.5x with bubbles on top.",
        "ingredients": [
          {
            "name": "Bread flour",
            "amount": 400,
            "unit": "g"
          },
          {
            "name": "Whole wheat flour",
            "amount": 100,
            "unit": "g"
          },
          {
            "name": "Water",
            "amount": 360,
            "unit": "g",
            "note": "about 30°C"
          },
          {
            "name": "Salt",
            "amount": 10,
            "unit": "g"
          },
          {
            "name": "Instant yeast",
            "amount": 3,
            "unit": "g"
          }
        ],
        "steps": [
          {
            "text": "Mix flour and water, rest (autolyse)",
            "minutes": 30,
            "kind": "rest"
          },
          {
            "text": "Add salt and yeast, knead until smooth",
            "minutes": 10,
            "kind": "knead"
          },
          {
            "text": "Bulk ferment, fold every 30 min",
            "minutes": 120,
            "kind": "ferment"
          },
          {
            "text": "Pre-shape and rest",
            "minutes": 20,
            "kind": "rest"
          },
          {
            "text": "Shape into a banneton, final proof",
            "minutes": 60,
            "kind": "ferment"
          },
          {
            "text": "Preheat oven and Dutch oven to 250°C",
            "minutes": 45,
            "kind": "bake"
          },
          {
            "text": "Score and bake with the lid on",
            "minutes": 20,
            "kind": "bake"
          },
          {
            "text": "Lid off, bake at 230°C until deep brown",
            "minutes": 20,
            "kind": "bake"
          },
          {
            "text": "Cool before slicing",
            "minutes": 60,
            "kind": "rest"
          }
        ]
      }
