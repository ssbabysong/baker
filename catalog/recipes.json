        "ingredients": [
          {
            "name": "高筋面粉",
            "amount": 250,
            "unit": "g"
          },
          {
            "name": "细砂糖",
            "amount": 30,
            "unit": "g"
          },
          {
            "name": "盐",
            "amount": 3,
            "unit": "g"
          },
          {
            "name": "即发干酵母",
            "amount": 3,
            "unit": "g"
          },
          {
            "name": "全蛋液",
            "amount": 25,
            "unit": "g"
          },
          {
            "name": "牛奶",
            "amount": 140,
            "unit": "g"
          },
          {
            "name": "黄油",
            "amount": 20,
            "unit": "g",
            "note": "软化"
          },
          {
            "name": "红豆馅",
            "amount": 320,
            "unit": "g",
            "note": "每个 40g"
          },
          {
            "name": "黑芝麻",
            "amount": null,
            "unit": "少许"
          }
        ],
        "steps": [
          {
            "text": "除黄油外的材料揉成团，再加黄油揉到扩展阶段",
            "minutes": 15,
            "kind": "knead"
