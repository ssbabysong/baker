            "minutes": 15,
            "kind": "rest"
          },
          {
            "text": "包入红豆馅收口，压扁，中间按一个小窝撒芝麻",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "二次发酵",
            "minutes": 40,
            "kind": "ferment"
          },
          {
            "text": "刷蛋液，180°C 烤",
            "minutes": 13,
            "kind": "bake"
          }
        ]
