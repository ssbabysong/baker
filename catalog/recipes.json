    {
      "key": "chocobun",
      "rev": 1,
      "shape": "chocobun",
      "zh": {
        "name": "巧克力脆脆珠面包",
        "yield": "10 个",
        "notes": "",
        "ingredients": [
          {
            "name": "高筋面粉",
            "amount": 250,
            "unit": "克",
            "note": "面包体"
          },
          {
            "name": "可可粉",
            "amount": 15,
            "unit": "克",
            "note": "面包体"
          },
          {
            "name": "牛奶",
            "amount": 130,
            "unit": "克",
            "note": "面包体 · 130-150克"
          },
          {
            "name": "淡奶油",
            "amount": 100,
            "unit": "克",
            "note": "面包体"
          },
          {
            "name": "细砂糖",
            "amount": 25,
            "unit": "克",
            "note": "面包体"
          },
          {
            "name": "鲜酵母",
            "amount": 8,
            "unit": "克",
            "note": "或高糖干酵母 3 克"
          },
          {
            "name": "盐",
            "amount": 3,
            "unit": "克",
            "note": "面包体"
          },
          {
            "name": "黑巧克力",
            "amount": 210,
            "unit": "克",
            "note": "馅料 · 嘉利宝 54%"
          },
          {
            "name": "淡奶油",
            "amount": 190,
            "unit": "克",
            "note": "馅料"
          },
          {
            "name": "巧克力脆脆珠",
            "amount": null,
            "unit": "适量",
            "note": "馅料"
          }
        ],
        "steps": [
          {
            "text": "面团用的材料全部加入厨师机。机器定时13分钟；2档10秒，3档10秒，4档10秒，5档30秒，6档12分",
            "minutes": 13,
            "kind": "knead"
          },
          {
            "text": "收圆，表面喷水，放入发酵箱，温度28，湿度75%，进行一次发酵，发酵至体积2-2.5倍",
            "minutes": null,
            "kind": "ferment"
          },
          {
            "text": "移到操作台上，称总重后分割10等份。按压排气后，分别收圆。",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "留出空隙，摆在烤盘上。放入发酵箱，温度32-35度，湿度85%，进行第二次发酵。",
            "minutes": null,
            "kind": "ferment"
          },
          {
            "text": "发酵期间准备甘纳许内馅：碗里加入巧克力、淡奶油，隔热水加热至巧克力融化，搅拌均匀",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "装入裱花袋冷却，室温高的可以放冰箱冷藏。",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "面团发酵至体积2倍大后，表面均匀刷一层鸡蛋液。",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "放入预热好的烤箱，放中下层，上下火180度，烤15分",
            "minutes": 15,
            "kind": "bake"
          },
          {
            "text": "出炉立刻震盘，冷却巧克力脆脆珠面包，冷却后表皮会变皱，正常的",
            "minutes": null,
            "kind": "rest"
          },
          {
            "text": "面包冷却后，用面包刀在中间切开，不切断",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "稍微掰开一点，挤入甘纳许，用小抹刀抹平，面包切面也抹均匀，方便粘住脆脆珠巧克力脆脆珠",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "巧克力脆脆珠倒入深的容器，面包倒扣进去，粘满脆脆珠，没粘到的手动补均匀",
            "minutes": null,
            "kind": "other"
          }
        ]
      },
      "en": {
        "name": "Chocolate Crunch Pearl Buns",
        "yield": "10 buns",
        "notes": "",
        "ingredients": [
          {
            "name": "Bread flour",
            "amount": 250,
            "unit": "g",
            "note": "dough"
          },
          {
            "name": "Cocoa powder",
            "amount": 15,
            "unit": "g",
            "note": "dough"
          },
          {
            "name": "Milk",
            "amount": 130,
            "unit": "g",
            "note": "dough · 130-150g"
          },
          {
            "name": "Heavy cream",
            "amount": 100,
            "unit": "g",
            "note": "dough"
          },
          {
            "name": "Sugar",
            "amount": 25,
            "unit": "g",
            "note": "dough"
          },
          {
            "name": "Fresh yeast",
            "amount": 8,
            "unit": "g",
            "note": "or 3g osmotolerant instant yeast"
          },
          {
            "name": "Salt",
            "amount": 3,
            "unit": "g",
            "note": "dough"
          },
          {
            "name": "Dark chocolate",
            "amount": 210,
            "unit": "g",
            "note": "filling · Callebaut 54%"
          },
          {
            "name": "Heavy cream",
            "amount": 190,
            "unit": "g",
            "note": "filling"
          },
          {
            "name": "Chocolate crunch pearls",
            "amount": null,
            "unit": "as needed",
            "note": "filling"
          }
        ],
        "steps": [
          {
            "text": "Put all the dough ingredients in the stand mixer. Set 13 min: speed 2 for 10 s, 3 for 10 s, 4 for 10 s, 5 for 30 s, then 6 for 12 min",
            "minutes": 13,
            "kind": "knead"
          },
          {
            "text": "Round the dough, mist the top and proof at 28°C, 75% humidity until 2-2.5x in size",
            "minutes": null,
            "kind": "ferment"
          },
          {
            "text": "Turn out, weigh and divide into 10. Press out the air and round each piece",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "Space them out on a tray. Second proof at 32-35°C, 85% humidity",
            "minutes": null,
            "kind": "ferment"
          },
          {
            "text": "Meanwhile make the ganache: melt the chocolate and cream over hot water, stir until smooth",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "Spoon into a piping bag and let it cool; chill it if the room is warm",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "When the buns have doubled, brush with egg wash",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "Bake on the lower-middle rack at 180°C top and bottom heat for 15 min",
            "minutes": 15,
            "kind": "bake"
          },
          {
            "text": "Bang the tray as soon as it comes out and let the buns cool. The crust wrinkles as it cools, that’s normal",
            "minutes": null,
            "kind": "rest"
          },
          {
            "text": "Once cool, slice down the middle with a bread knife without cutting through",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "Open slightly, pipe in the ganache and smooth it with a small spatula, also over the cut faces so the pearls stick",
            "minutes": null,
            "kind": "other"
          },
          {
            "text": "Pour the crunch pearls into a deep bowl, dip the buns upside down to coat, and patch any gaps by hand",
            "minutes": null,
            "kind": "other"
          }
        ]
      }
    }
  ],
  "removed": []
}
